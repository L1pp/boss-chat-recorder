{
  "name": "boss-chat-recorder-showcase",
  "version": "0.8.12",
  "private": true,
  "description": "Local-first BOSS Zhipin chat archiving: read-only collection, incremental updates, account isolation, and factual AI exports.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build-extension.mjs",
    "build:check": "node scripts/build-extension.mjs --check",
    "demo": "node scripts/generate-demo.mjs",
    "package:extension": "node scripts/package-extension.mjs",
    "store:status": "node scripts/chrome-webstore.mjs status",
    "store:upload": "node scripts/chrome-webstore.mjs upload",
    "store:publish": "node scripts/chrome-webstore.mjs publish",
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node scripts/test-coverage.mjs",
    "test:browser": "node scripts/browser-tests.mjs test",
    "test:browser:install": "node scripts/browser-tests.mjs install",
    "check": "npm run build:check && node scripts/check-release.mjs"
  },
  "showcaseProfile": "public",
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
