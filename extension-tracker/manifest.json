{
  "manifest_version": 3,
  "name": "BOSS 沟通记录本地助手",
  "version": "0.8.10",
  "description": "按当前 BOSS 账号保存沟通记录，并导出供用户自行分析的事实数据。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
